    "log_summary": "FAST",
    "test_output_summary": "FAST",
    "classification": "FAST",
    "requirement_analysis": "STANDARD",
    "routine_review": "STANDARD",
    "routine_implementation": "STANDARD",
    "unit_test_generation": "STANDARD",
    "debugging": "STANDARD",
    "architecture": "DEEP",
    "schema_design": "DEEP",
    "security_review": "DEEP",
    "performance_review": "DEEP",
    "deep_investigation": "DEEP",
    "high_risk_implementation": "DEEP"
  },
