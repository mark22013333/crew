{
  "schema_version": 1,
  "profiles": {
    "NONE": {
      "rank": 0,
      "description": "Deterministic tooling; do not call an LLM."
    },
    "FAST": {
      "rank": 1,
      "description": "Cheap read-only mechanical work: search, extraction, classification, summarization."
    },
    "STANDARD": {
      "rank": 2,
      "description": "Normal engineering reasoning and routine implementation/review."
    },
    "DEEP": {
      "rank": 3,
      "description": "Complex or high-risk reasoning: architecture, schema, security, concurrency, difficult debugging."
    }
  },
  "task_defaults": {
    "deterministic": "NONE",
    "state_transition": "NONE",
    "schema_validation": "NONE",
    "git_diff": "NONE",
    "repository_search": "FAST",
